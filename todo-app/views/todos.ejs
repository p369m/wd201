<section>
  <!-- Overdue Todos Section -->
  <h5>Overdue (<span id="count-overdue"><%= overdueTodos.length %></span>)</h5>
  <ul>
    <% overdueTodos.forEach(todo => { %>
    <li><%= todo.title %> (Due: <%= todo.dueDate %>)</li>
    <% }) %>
  </ul>
</section>
<!-- Todos Due Today Section -->
<section>
  <h5>
    Due Today (<span id="count-due-today"><%= dueTodayTodos.length %></span>)
  </h5>
  <ul>
    <% dueTodayTodos.forEach(todo => { %>
    <li><%= todo.title %> (Due: <%= todo.dueDate %>)</li>
    <% }) %>
  </ul>
</section>
<!-- Todos Due Later Section -->
<section>
  <h5>
    Due Later (<span id="count-due-later"><%= dueLaterTodos.length %></span>)
  </h5>
  <ul>
    <% dueLaterTodos.forEach(todo => { %>
    <li><%= todo.title %> (Due: <%= todo.dueDate %>)</li>
    <% }) %>
  </ul>
</section>
